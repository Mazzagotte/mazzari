    "deploy:worker": "opennextjs-cloudflare deploy",
    "check:worker": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@opennextjs/cloudflare": "^1.20.12",
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
