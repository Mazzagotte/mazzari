{
  "name": "splitflap-smart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 1000",
    "build": "next build",
    "start": "next start -p 1000",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/display.test.ts tests/messages.test.ts tests/features.test.ts",
    "build:worker": "node scripts/build-worker.mjs",
