{
  "name": "splitflap-smart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 1000",
    "build": "next build",
    "start": "next start -p 1000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/display.test.ts tests/messages.test.ts tests/features.test.ts tests/app.test.ts",
    "build:worker": "node scripts/build-worker.mjs",
    "preview:worker": "opennextjs-cloudflare preview",
    "deploy:worker": "opennextjs-cloudflare deploy",
    "check:worker": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
